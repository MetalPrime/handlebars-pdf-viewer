<html>
<style>

    @page:first {
    background: url('https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/innovations/cover-PDF-Innovations.png') no-repeat center center;
    background-size: cover;
    margin: 0; /* Remove default margin */
    }

    @font-face {
        font-family: 'Montserrat';
        src: url('data:font/woff2;base64,' format("woff2"));
        font-weight: normal;
        font-style: normal;
    }

    body {
        font-family: 'Montserrat', sans-serif;
        font-size: 11px;
        color: #333;
        margin: 0;
    }

    h1 {
        font-size: 14px;
        color: #333;
        font-weight: bold;
    }
    
    #pageHeader{
        margin: 0;
        width: 100%;
        background-color: transparent;
        position: running(pageHeader);
    }

    #pageHeader-1{
        margin: 0;
        width: 100%;
        background-color: transparent;
        position: running(pageHeader-1);
    }

    #pageContent{
        overflow: visible;
    }

    #pageFooter{
        margin: 0;
        width: 100%;
        background-color: transparent;
        position: running(pageFooter);
        bottom: 0;
    }

    .page {
        display: block;
        padding-top: 2px;
        padding-right: 5rem;
        padding-left: 5rem;
    }

    .full-page-height {
        height: 976px;
    }

    .first-page {
        height: 100%;
        text-align: center;
        position: relative;
        background-image: url('https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/innovations/cover-PDF-Innovations.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        margin-top: -10mm; /* Compensate for header margin */
        padding-top: 10mm; /* Add padding to maintain content position */
        display: flex;
        flex-wrap: wrap;
        align-content: space-between;

    }

    .header {
        width: 100%;
        margin-bottom: 10px;
        border-collapse: collapse;
    }

    .header td {
        padding: 10px;
        vertical-align: middle;
    }

    .header h3 {
        margin: 0;
        text-align: left;
        font-size: 14px;
        color: #333;
    }

    .header-logo {
        text-align: right;
    }

    .header-logo img {
        max-width: 75%;
        height: auto;
    }

    /* Add page-specific styles */
    .page-container {
        position: relative;
        min-height: 100%;
        padding-bottom: 10mm; /* Footer height */
    }

    .img-background {
        position: fixed;
        bottom: 0px;
        left: 0;
        z-index: -1;
        overflow: visible;
    }

    .img-background-top {
        top: 0;
        botttom: auto;
    }

    span.section {}

    span.section>.mainTitle{
        font-size: 14px;
        font-weight: bold;
        color: #0C9999;
    }

    span.section>.title {
        font-size: 14px;
        font-weight: bold;
        color: #34752D;
    }

    span.section>.subtitle{
        font-size: 11px;
        font-weight: bold;
        color: #333;
    }

    span.field{ 
        display: block; 
        margin-bottom: 3px;
        font-weight: lighter; 
        font-size: 11px;
    }

    span.name {
        font-weight: bold;
    }

    span.subtitle {
        display: block;
        font-size: 8px;
    }

    table {
        font-size: 9px;
        overflow: hidden;
    }

    table p.mainText {
        font-size: 9px;
        color: #333;
        font-weight: bold;
        text-align: center;
    }

    table p.caption {
        font-size: 8px;
        color: #333;
        text-align: center;
    }

    .table{ 
        width: 100%; 
        border-collapse: collapse; 
    } 
    .table td,.table th { 
        border: 1px solid #a8d08d; 
        padding: 8px; 
        vertical-align: top; 
    } 
    .table tr:nth-child(even){
        background-color: #e2efd9;
    } 
    .table th{ 
        text-align: center; 
        padding: 8px; 
        background-color: #7ab800; 
        color: white; 
    } 

    .table_transparent{ 
        width: 100%; 
        border-collapse: collapse; 
        border: none; 
    }

    .table_blue{ 
        width: 100%; 
        border-collapse: collapse; 
        border: 1px solid #57A7B5;
    } 
    .table_blue td, .table_blue th { 
        padding: 8px; 
        vertical-align: top;
        border: 1px solid #57A7B5;
    } 
    
    .table_blue tr:nth-child(odd){
        background-color: #CEE6EA; 
    } 
    .table_blue th{ 
        text-align: center; 
        padding: 8px; 
        background-color:#57A7B5; 
        color: white; 
    }

    .opacity-50 {
        fill-opacity: 0.5;
    }

    @media print {
        .first-page {
            page-break-after: always;
        }
    }
</style>

<head>
    <meta charset="UTF-8" />
    <title>Generated Report</title>
</head>

<body>
    <div id="pageHeader">
    </div>

    <div id="pageContent">
        
        <span class="page full-page-height first-page">
            <table style="height: 100%; width: 100%;">
                <tr>
                    <td style="text-align: center; vertical-align: middle;">
                        <h1>{{#safeEmpty}}{{title}}{{/safeEmpty}}</h1>
                    </td>
                </tr>
            </table>
        </span>

        <span class="page">

            <span class="section">
                <h1 class="mainTitle">SECTION: At a glance</h1>
                <h2 class="title">Description</h2>
                <span class="content">
                    <span class="field">
                        {{#safeEmpty}}{{{narrative}}}{{/safeEmpty}}
                    </span>
                </span>
            </span>

            <br>

            <span class="section">
                <h2 class="title">General Information</h2>
                <span class="content">
                    <table class="table_transparent">
                        <tr>
                            <td width="10%">
                                <img src="https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/code.png" width="48px" />
                            </td>
                            <td width="17.5%">
                                <span class="field">
                                    <span class="name subtitle" style=" color: #8CBF30;">Innovation ID </span>
                                    <span style="font-size: 8px;">{{#safeEmpty}}{{id}}{{/safeEmpty}}</span>
                                </span>
                            </td>
                            <td width="10%">
                                <img src="https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/innovations/Inno+Cluster.png" width="48px" />
                            </td>
                            <td width="17.5%">
                                <span class="field">
                                    <span class="name subtitle" style="color: #0C9999;">Cluster lead </span>
                                    <span style="font-size: 8px;">{{#safeEmpty}}{{clusterAcronym}}{{/safeEmpty}}</span>
                                </span>
                            </td>
                            <td width="10%">
                                <img src="https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/year.png" width="48px" />
                            </td>
                            <td width="17.5%">
                                <span class="field">
                                    <span class="name subtitle" style="display: block; color: #F4971A;">Report year </span>
                                    <span style="font-size: 8px;">{{#safeEmpty}}{{year}}{{/safeEmpty}}</span>
                                </span>
                            </td>
                        </tr>
                    </table>
                    <br>
                    <table class="table_transparent">
                        <tr>
                            <td width="20%"></td>
                            <td width="12.5%">
                                <img src="https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/innovations/Inno+nature.png" width="48px" />
                            </td>
                            <td width="17.5%">
                                <span class="field">
                                    <span class="name subtitle" style="color: #34752D;">Nature </span>
                                    <span style="font-size: 8px;">{{#safeEmpty}}{{repIndInnovationNature}}{{/safeEmpty}}</span>
                                </span>
                            </td>
                            <td width="12.5%">
                                <img src="https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/innovations/Inno+type.png" width="48px" />
                            </td>
                            <td width="17.5%">
                                <span class="field">
                                    <span class="name subtitle" style="color: #BF8F00;">Type </span>
                                    <span style="font-size: 8px;">{{#safeEmpty}}{{repIndInnovationType}}{{/safeEmpty}}</span>
                                </span>
                            </td>
                            <td width="20%"></td>
                        </tr>
                    </table>
                    <br>    
                </span>
            </span>

            <br>

            <span class="section">
                <h2 class="title">Impact Area contribution </h2>
                <span class="content">
                    <table class="table_transparent">
                        <tr>
                            <td style="text-align: center;" width="20%">
                                <img
                                width='65px'
                                height='65px'
                                src='https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/dac_markers/DAC+Markers+-+Nutrition.png'
                                alt='Nutrition, health and food Score'
                                />
                            </td>
                            <td style="text-align: center;" width="20%">
                                <img
                                width='65px'
                                height='65px'
                                src='https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/dac_markers/DAC+Markers+-+Gender.png'
                                alt='Gender quality Score'
                                />
                            </td>
                            <td style="text-align: center;" width="20%">
                                <img
                                width='65px'
                                height='65px'
                                src='https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/dac_markers/DAC+Markers+-+Poverty.png'
                                alt='Poverty reduction Score'
                                />
                            </td>
                            <td style="text-align: center;" width="20%">
                                <img
                                width='65px'
                                height='65px'
                                src='https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/dac_markers/DAC+Markers+-+Climate.png'
                                alt='Climate change Score'
                                />
                            </td>
                            <td style="text-align: center;" width="20%">
                                <img
                                width='65px'
                                height='65px'
                                src='https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/dac_markers/DAC+Markers+-+Environmental.png'
                                alt='Enviromental health Score'
                                />
                            </td>
                        </tr>
                        <tr>
                            <td style='text-align: center;' width="20%"><b>{{#safeEmpty}}{{foodSecurityScore}}{{/safeEmpty}}</b></td>
                            <td style='text-align: center;' width="20%"><b>{{#safeEmpty}}{{genderScore}}{{/safeEmpty}}</b></td>
                            <td style='text-align: center;' width="20%"><b>{{#safeEmpty}}{{povertyScore}}{{/safeEmpty}}</b></td>
                            <td style='text-align: center;' width="20%"><b>{{#safeEmpty}}{{climateChangeScore}}{{/safeEmpty}}</b></td>
                            <td style='text-align: center;' width="20%"><b>{{#safeEmpty}}{{environmentalScore}}{{/safeEmpty}}</b></td>
                        </tr>
                    </table>

                    <p style='font-size: 7px; margin-top: 16px;'>
                        0 = Not targeted: The result did not target any of the Impact Area objectives.
                        <br />
                        1 = Significant: The result has made a significant contribution to any of the Impact
                        Area objectives, even though the objective(s) is not the principal focus of the
                        result.
                        <br />
                        2 = Principal: The result is principally about meeting any of the Impact Area
                        objectives, and this is fundamental in its design and expected results. The result
                        would not have been undertaken without this objective.
                    </p>
                </span>
            </span>

            <br>

            <span class="section">
                <h2 class="title">Other cluster contribution</h2>
                <span class="content">
                    {{#if studyProjects}}
                    <ul>
                        {{#each (parseJSON studyProjects)}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                    {{else}}
                    Not provided
                    {{/if}}
                </span>
            </span>

            <br>

            <span class="section">
                <h2 class="title">Geographic location</h2>
                <span class="content">
                    <table class="table_transparent" style="page-break-inside: avoid; break-inside: avoid; ">
                        <tr>
                            <td width="20%">
                                <img src="https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/Africa.png" width="73.92px" height="78.72px" />
                            </td>
                            <td width="80%">
                                <span class="field">
                                    <span class="name ">Scope: </span> {{#safeEmpty}}{{geographicScopes}}{{/safeEmpty}}
                                </span>
                                <span class="field">
                                    <span class="name">Country(ies): </span> {{#safeEmpty}}{{countries}}{{/safeEmpty}}
                                </span>
                                <span class="field">
                                    <span class="name">Region(s): </span> {{#safeEmpty}}{{regions}}{{/safeEmpty}}
                                </span>
                            </td>
                        </tr>
                    </table>
                </span>
            </span>

            <span class="section">
                <h2 class="title">Key contributors</h2>
                <span class="content">
                    <h3 class="subtitle" style="font-size: 9px;">CG Centers/Managing partners:</h3>
                    <table class="table">
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                        </tr>
                        {{#if centers}}
                            {{#each (parseJSON centers)}}
                            <tr>
                                <td>{{this.name}}</td>
                                <td>{{this.type}}</td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="4" style="text-align: center; font-style: italic;">Not provided</td>
                            </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan="4" style="text-align: center; font-style: italic;">Not provided</td>
                            </tr>
                        {{/if}}
                    </table>
                    <p style="font-size: 8px;">Note: These are the partners who have significantly contributed to the reported innovation.</p>
                </span>
                <br>
                <span class="content">
                    <h3 class="subtitle" style="font-size: 9px;">External partners:</h3>
                    <table class="table">
                        <tr>
                            <th>Name</th>
                            <th style="width: 20%;">Type</th>
                            <th style="width: 20%;">Role</th>
                        </tr>
                        {{#if institutions}}
                            {{#each (parseJSON institutions)}}
                            <tr>
                                <td>{{this.name}}</td>
                                <td>{{this.type}}</td>
                                <td>
                                    {{#ifOr this.isResearch this.isCapacityBuilding this.isScaling this.isDemand this.isInnovation this.isOther}}                                    
                                        {{#if this.isScaling}}Scaling <br>{{/if}}
                                        {{#if this.isDemand}}Demand <br>{{/if}}
                                        {{#if this.isInnovation}}Innovation <br>{{/if}}
                                        {{#if this.isOther}}Other <br>{{/if}}
                                    {{else}}
                                        Not provided
                                    {{/ifOr}}
                                </td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="5" style="text-align: center; font-style: italic;">Not provided</td>
                            </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan="5" style="text-align: center; font-style: italic;">Not provided</td>
                            </tr>
                        {{/if}}
                    </table>
                    <p style="font-size: 8px;">Note: These are the partners who have significantly contributed to the reported innovation.</p>
                </span>
            </span>

            <br>

            <span class="section">
                <h2 class="title">Links to performance indicators</h2>
                <span class="content">
                    {{#if performanceIndicator}}
                    <ul>
                        {{#each (parseJSON performanceIndicator)}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                    {{else}}
                    Not provided
                    {{/if}}
                </span>
            </span>

        </span>
        
        <span class="page" style="page-break-after: always;">
            <span class="section">
                <h1 class="mainTitle">SECTION: knowledge sharing and Scaling potential</h1>
                <h2 class="title">Anticipated users of this innovation</h2>
                <h3 class="subtitle">Actors</h3>
                <span class="content">
                    <table class="table_blue">
                        <tr>
                            <th width="5%">#</th>
                            <th width="30%" style="word-break: break-all; overflow-wrap: break-word; word-wrap: break-word;">Type</th>
                            <th width="20%">Total</th>
                            <th width="22.5%">Of which women</th>
                            <th width="22.5%">Of which youth</th>
                        </tr>
                        {{#if actors}}
                            {{#each (parseJSON actors)}}
                                {{#ifEquals this.sexAgeNotApply 'Yes'}}
                                    <tr>
                                        <td width="5%">{{mathOperator @index "+" 1 ""}}</td>
                                        <td width="30%;"
                                            style=" word-break: break-all; overflow-wrap: break-word; word-wrap: break-word;">
                                            {{#safeEmpty}}{{this.type}}{{/safeEmpty}}
                                        </td>
                                        <td width="20%">{{#safeEmpty}}{{this.total}}{{/safeEmpty}}</td>
                                        <td width="22.5%">Not applicable</td>
                                        <td width="22.5%">Not applicable</td>
                                    </tr>
                                {{else}}
                                    <tr>
                                        <td width="5%">{{mathOperator @index "+" 1 ""}}</td>
                                        <td width="30%;"
                                            style=" word-break: break-all; overflow-wrap: break-word; word-wrap: break-word;">
                                            {{#safeEmpty}}{{this.type}}{{/safeEmpty}}
                                        </td>
                                        <td width="20%">{{#safeEmpty}}{{this.total}}{{/safeEmpty}}</td>
                                        <td width="22.5%">{{#safeEmpty}}{{this.womenYouthNumber}}{{/safeEmpty}}</td>
                                        <td width="22.5%">{{#safeEmpty}}{{this.womenNotYouthNumber}}{{/safeEmpty}}</td>
                                {{/ifEquals}}
                            {{else}}
                            <tr>
                                <td colspan="6" style="text-align: center; font-style: italic;">Not provided</td>
                            </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan="6" style="text-align: center; font-style: italic;">Not provided</td>
                            </tr>
                        {{/if}}
                    </table>
                </span>
                <h3 class="subtitle">Organizations</h3>
                <span class="content">
                    <table class="table_blue">
                        <tr>
                            <th style="5%">#</th>
                            <th style="15%">Type</th>
                            <th style="80%">Name</th>
                        </tr>
                        {{#if allianceOrganizations}}
                            {{#each (parseJSON allianceOrganizations)}}
                            <tr>
                                <td style="5%">{{mathOperator @index "+" 1 ""}}</td>
                                <td style="15%">{{#safeEmpty}}{{this.type}}{{/safeEmpty}}</td>
                                <td style="80%">{{#safeEmpty}}{{this.name}}{{/safeEmpty}}</td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="4" style="text-align: center; font-style: italic;">Not provided</td>
                            </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan="4" style="text-align: center; font-style: italic;">Not provided</td>
                            </tr>
                        {{/if}}
                    </table>
                </span>
                <h3 class="subtitle">Intended beneficiaries/users likely to benefit </h3>
                <span class="content">
                    <span class="field">
                        {{#safeEmpty}}{{{beneficiariesNarrative}}}{{/safeEmpty}}
                    </span>
                </span>
            </span>
        </span>

        <span class="page" style="page-break-before: always;">
            <table style="height: 100%; width: 100%;">
                <tr>
                    <td style='width: 65%; vertical-align: top;'>
                        <span class='section'>
                            <h3 class="subtitle">Scaling barriers</h3>
                            {{#ifEquals foreseeBarriers 'Yes'}}
                                <span class="content">
                                    <span class="field">
                                        {{#safeEmpty}}{{{scalingBarriers}}}{{/safeEmpty}}
                                    </span>
                                </span>
                            {{else}}
                                <span class="content">
                                    <span class="field">
                                        Not provided
                                    </span>
                                </span>
                            {{/ifEquals}}
                            <h3 class="subtitle">Methods and tools that were developed to support the outreach and the use of this reported innovation</h3>
                            {{#if knowledgeMethodsAndToolsNarrative}}
                                <span class="content">
                                    <span class="field">
                                        {{#safeEmpty}}{{{knowledgeMethodsAndToolsNarrative}}}{{/safeEmpty}}
                                    </span>
                                </span>
                            {{else}}
                                <span class="content">
                                    <span class="field">
                                        Not provided
                                    </span>
                                </span>
                            {{/if}}
                            <h3 class="subtitle">Results achieved and outcomes expected:</h3>
                            <span class="content">
                                <span class="field">
                                    {{#safeEmpty}}{{{knowledgeResultsNarrative}}}{{/safeEmpty}}
                                </span>
                            </span>
                        </span>
                    </td>

                    <td style='width:35%; vertical-align: top; text-align: center;'>
                        <div style="margin-top: 0px;">
                            {{#if readinessScale}}
                                <img 
                                    width='100%' 
                                    src="https://prms-file-storage.s3.amazonaws.com/images/inno-scaling-readiness-{{readinessScale}}.png" 
                                    alt='Scaling Readiness Diagram'
                                />
                            {{else}}
                                <img
                                    width='100%'
                                    src='https://prms-file-storage.s3.amazonaws.com/images/inno-scaling-readiness-not-provided.png'
                                    alt='Scaling Readiness Diagram Not Provided'
                                />
                            {{/if}}
                            <br />
                            <span style='font-size: 10px;'>
                                Learn more in
                                <a
                                    href='https://www.scalingreadiness.org'
                                    target='_blank'
                                    rel='noopener noreferrer'
                                    class='link'
                                >www.scalingreadiness.org</a>
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </span>

        <span class="page">
            <span class="section">
                <h2 class="title">Levels by scaling potential</h2>
                <span class="content">
                    <h3 class="subtitle">Technical excellence</h3>
                    <table class="table_transparent">
                        <td style="width: 33%;">
                            <p class="mainText">{{#safeEmpty}}{{{cheaperAlternatives}}}{{/safeEmpty}}</p>
                            <p class="caption">Cheaper compared to alternatives</p>
                        </td>
                        <td style="width: 33%;">
                            <p class="mainText">{{#safeEmpty}}{{{simplerUse}}}{{/safeEmpty}}</p>
                            <p class="caption">Simple to use</p>
                        </td>
                        <td style="width: 33%;">
                            <p class="mainText">{{#safeEmpty}}{{{performBetter}}}{{/safeEmpty}}</p>
                            <p class="caption">Perform better</p>
                        </td>
                    </table>
                    <h3 class="subtitle">Demand and Investment</h3>
                    <table class="table_transparent">
                        <td style="width: 30%;">
                            <p class="mainText">{{#safeEmpty}}{{{innovationDesirable}}}{{/safeEmpty}}</p>
                            <p class="caption">Desirable to intended users</p>
                        </td>
                        <td style="width: 50%;">
                            <p class="mainText">{{#safeEmpty}}{{{innovationCommercially}}}{{/safeEmpty}}</p>
                            <p class="caption">Commercially viable/is there investment potential</p>
                        </td>
                        <td style="width: 30%;">

                        </td>
                    </table>
                    <h3 class="subtitle">Sustained use</h3>
                    <table class="table_transparent">
                        <td style="width: 40%;">
                            <p class="mainText">{{#safeEmpty}}{{{innovationSupported}}}{{/safeEmpty}}</p>
                            <p class="caption">Supported by a suitable enabling environment</p>
                        </td>
                        <td style="width: 20%;">
                            <p class="mainText">{{#safeEmpty}}{{{evidenceUptake}}}{{/safeEmpty}}</p>
                            <p class="caption">Evidence of uptake</p>
                        </td>
                        <td style="width: 30%;">

                        </td>
                    </table>
                </span>
            </span>
            <br>
            <span class="section">
                <h2 class="title">Evidence and reference</h2>
                <span class="content">
                    <table class="table_blue">
                        <tr>
                            <th>#</th>
                            <th>Evidence/Reference</th>
                            <th>Category</th>
                            <th>Related level</th>
                            <th>Link</th>
                        </tr>
                        {{#if references }}
                            {{#each (parseJSON references)}}
                            <tr>
                                <td style="width: 5%;">{{mathOperator @index "+" 1}}</td>
                                <td style="width: 30%;">{{#safeEmpty}}{{this.reference}}{{/safeEmpty}}</td>
                                <td style="width: 20%;">{{#safeEmpty}}{{this.deliverableCategory}}{{/safeEmpty}} - {{#safeEmpty}}{{this.deliverableType}}{{/safeEmpty}}</td>
                                <td style="width: 20%;">
                                    {{#ifOr this.foodSecurity this.poverty this.climateChange this.nutrition this.enviromental this.innovationReadiness }}                                        
                                        {{#if this.poverty}}Poverty <br>{{/if}}
                                        {{#if this.gender}}Gender <br>{{/if}}
                                        {{#if this.climateChange}}Climate Change <br>{{/if}}
                                        {{#if this.nutrition}}Nutrition <br>{{/if}}
                                        {{#if this.enviromental}}Environmental <br>{{/if}}
                                        {{#if this.innovationReadiness}}Innovation Readiness <br>{{/if}}
                                    {{else}}
                                        Not provided
                                    {{/ifOr}}
                                </td>
                                <td style="width: 25%; word-break: break-all;"><a href="{{this.url}}">{{#safeEmpty}}{{this.url}}{{/safeEmpty}}</a></td>
                            </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan="5" style="text-align: center; font-style: italic;">Not provided</td>
                            </tr>
                        {{/if}}
                    </table>
                </span>
            </span>
        </span>
    </div>

    <div id="pageFooter">
        <img src="https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/footer_W.png" class="img-background opacity-50 " />
        <table class="table_transparent opacity-50">
