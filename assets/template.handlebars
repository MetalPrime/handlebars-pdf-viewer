                </td>
                <td width="32%" style="text-align: right; vertical-align: middle; padding-right: 5rem; ">
                    <img src="https://marlo-pdf-resources-dev.s3.us-east-1.amazonaws.com/AICCRA-logo.png" alt="Logo AICCRA" width="95%" />
                </td>
            </tr>
        </table>
    </div>

